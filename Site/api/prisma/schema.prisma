// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuarios {
  id    Int    @id @default(autoincrement())
  email String @unique
  senha String

  login           Login?
  cadastro        Cadastro?
  perfil          PerfilUsuario?
  ranking         Ranking?
  desafiosCriados Desafios[]
  codigos         Codigos[]
}

model Login {
  id    Int    @id @default(autoincrement())
  email String
  senha String

  usuarios   Usuarios @relation(fields: [usuariosId], references: [id])
  usuariosId Int      @unique
}

model Cadastro {
  id             Int      @id @default(autoincrement())
  nome           String
  nomeUsuario    String   @unique
  email          String   @unique
  senha          String
  cpf            String   @unique
  dataNascimento DateTime

  usuarios   Usuarios @relation(fields: [usuariosId], references: [id])
  usuariosId Int      @unique
}

model PerfilUsuario {
  id Int @id @default(autoincrement())

  usuarios   Usuarios @relation(fields: [usuariosId], references: [id])
  usuariosId Int      @unique
}

model Ranking {
  id         Int @id @default(autoincrement())
  desempenho Int

  usuarios   Usuarios @relation(fields: [usuariosId], references: [id])
  usuariosId Int      @unique
}

model Desafios {
  id          Int         @id @default(autoincrement())
  descricao   String
  dificuldade Dificuldade @default(FACIL)
  casosTeste  String      @db.Text

  criador   Usuarios @relation(fields: [criadorId], references: [id])
  criadorId Int

  listagens ListagemDesafio[]
  codigos   Codigos[]
}

model ListagemDesafio {
  id    Int @id @default(autoincrement())
  idAdm Int

  desafio   Desafios @relation(fields: [desafioId], references: [id])
  desafioId Int

  codigos Codigos[]
}

model Codigos {
  id Int @id @default(autoincrement())

  usuarios   Usuarios @relation(fields: [usuariosId], references: [id])
  usuariosId Int

  desafio   Desafios @relation(fields: [desafioId], references: [id])
  desafioId Int

  listagemDesafio   ListagemDesafio @relation(fields: [listagemDesafioId], references: [id])
  listagemDesafioId Int

  avaliacao AvaliacaoCodigo?
}

model AvaliacaoCodigo {
  id                  Int    @id @default(autoincrement())
  avaliacaoAutomatica String @db.Text

  codigo   Codigos @relation(fields: [codigoId], references: [id])
  codigoId Int     @unique
}

enum Dificuldade {
  FACIL
  MEDIO
  DIFICIL
}
