generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AchievementType {
  PROBLEM_SOLVING
  STREAK
  LESSON
  SPECIAL
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String

  role      UserRole @default(USER)
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Question {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  difficulty  Difficulty

  status      QuestionStatus @default(DRAFT)

  constraints String?
  examples    Json?
  starterCode Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("questions")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  @@map("tags")
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  content     String

  status     LessonStatus @default(DRAFT)
  difficulty Difficulty?
  order      Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lessons")
}

model Achievement {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  icon        String?
  type        AchievementType

  createdAt DateTime @default(now())

  @@map("achievements")
}
